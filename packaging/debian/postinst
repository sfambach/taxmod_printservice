#!/bin/sh
set -e
# An update restarts the service of every user who runs it, so the new version prints at once.
if [ "$1" = "configure" ] && command -v loginctl >/dev/null 2>&1; then
    for user in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
        if systemctl --user -M "$user@" is-enabled --quiet taxmod-printservice.service 2>/dev/null; then
            systemctl --user -M "$user@" daemon-reload || true
            systemctl --user -M "$user@" restart taxmod-printservice.service || true
            echo "taxmod-printservice: restarted for $user"
        fi
    done
fi
if [ "$1" = "configure" ] && [ -z "$2" ]; then
    echo "taxmod-printservice: now run «taxmod-printservice setup» as the user that prints (not as root)."
fi
exit 0
