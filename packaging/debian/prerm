#!/bin/sh
set -e
# Removing the package stops the service everywhere; an upgrade leaves it to postinst.
if [ "$1" = "remove" ] && command -v loginctl >/dev/null 2>&1; then
    for user in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
        systemctl --user -M "$user@" disable --now taxmod-printservice.service 2>/dev/null || true
    done
fi
exit 0
